<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.LoginController"
      fx:id="rootPane">

    <StackPane fx:id="formSide" minWidth="520" prefWidth="620" HBox.hgrow="ALWAYS">
        <VBox fx:id="formBox" alignment="CENTER_LEFT" maxWidth="420" spacing="18">
            <padding>
                <Insets top="30" right="36" bottom="30" left="36"/>
            </padding>

            <VBox fx:id="logoBox" spacing="8"/>

            <VBox spacing="5">
                <Label fx:id="lblWelcome" text="Welcome"/>
                <Label fx:id="lblSubtitle" text="Sign in with your employee credentials"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Employee Number"/>
                <HBox fx:id="employeeFieldBox" alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets top="0" right="12" bottom="0" left="12"/>
                    </padding>
                    <FontIcon fx:id="employeeIcon"/>
                    <TextField fx:id="txtEmployeeNumber" promptText="e.g. 1042" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="8">
                <Label text="PIN"/>
                <HBox fx:id="pinFieldBox" alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets top="0" right="12" bottom="0" left="12"/>
                    </padding>
                    <FontIcon fx:id="pinIcon"/>
                    <PasswordField fx:id="txtPin" promptText="4-digit PIN" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Hyperlink fx:id="lnkForgotPin" text="Forgot PIN?" onAction="#handleForgotPin"/>
            </HBox>

            <Label fx:id="lblErro" visible="false" managed="false"/>

            <Button fx:id="btnLogin" text="Login" onAction="#handleLogin" maxWidth="Infinity" prefHeight="46"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="v1.0.0  Pellets Factory"/>
        </VBox>
    </StackPane>

    <StackPane fx:id="visualSide" HBox.hgrow="ALWAYS">
        <ImageView fx:id="heroImage" preserveRatio="false" smooth="true"/>
        <Region fx:id="heroOverlay"/>
        <VBox alignment="BOTTOM_LEFT" spacing="8" maxWidth="560" StackPane.alignment="BOTTOM_LEFT">
            <padding>
                <Insets top="36" right="36" bottom="36" left="36"/>
            </padding>
            <Label fx:id="lblVisualTitle" text="Operations Intelligence"/>
            <Label fx:id="lblVisualSubtitle" text="Control procurement, production, and stock in one place."/>
        </VBox>
    </StackPane>

</HBox>