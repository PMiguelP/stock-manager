<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import atlantafx.base.controls.Breadcrumbs?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.components.HeaderController"
      alignment="CENTER_LEFT" prefHeight="70.0" spacing="20"
      style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-muted; -fx-border-width: 0 0 1 0; -fx-padding: 0 30;">

    <VBox alignment="CENTER_LEFT" spacing="5">
        <Breadcrumbs fx:id="breadcrumbs"/>
    </VBox>

    <Region HBox.hgrow="ALWAYS"/>

    <HBox alignment="CENTER" spacing="15">
        <Button onAction="#handleOpenNotifications"
                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;"
                styleClass="button-icon">
            <graphic>
                <StackPane>
                    <FontIcon iconLiteral="mdi2b-bell-outline"
                              iconSize="22"
                    />
                    <Label text="2"
                           mouseTransparent="true"
                           style="-fx-background-color: -color-danger-emphasis; -fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold; -fx-padding: 1 4; -fx-background-radius: 10;"
                           StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin>
                            <Insets top="-4" right="-4"/>
                        </StackPane.margin>
                    </Label>
                </StackPane>
            </graphic>
        </Button>

        <HBox fx:id="profileBox" alignment="CENTER" spacing="12" onMouseClicked="#handleOpenSettings"
              style="-fx-cursor: hand; -fx-padding: 5 10; -fx-background-radius: 8;" styleClass="button-flat">

            <StackPane style="-fx-background-color: -color-accent-emphasis;
                            -fx-min-width: 38; -fx-max-width: 38; -fx-min-height: 38; -fx-max-height: 38;
                            -fx-shape: 'M 100, 100 m -75, 0 a 75,75 0 1,0 150,0 a 75,75 0 1,0 -150,0';">
                <Label text="AD" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </StackPane>

            <VBox alignment="CENTER_LEFT">
                <Label text="Admin User" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label text="admin@pellets.com" styleClass="text-muted" style="-fx-font-size: 11px;"/>
            </VBox>
        </HBox>
    </HBox>
</HBox>