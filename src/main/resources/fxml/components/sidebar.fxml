<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.components.SidebarController"
      prefWidth="250" spacing="2"
      style="-fx-background-color: -color-bg-subtle; -fx-border-color: -color-border-muted; -fx-border-width: 0 1 0 0;">

    <padding>
        <Insets top="20" right="10" bottom="20" left="10"/>
    </padding>

    <VBox spacing="5" style="-fx-padding: 0 0 24 10;">
        <ImageView fx:id="sidebarLogoImage" fitWidth="170" preserveRatio="true" smooth="true" pickOnBounds="true"/>
    </VBox>

    <Label fx:id="lblMainSection" text="sidebar.main" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: -color-fg-muted; -fx-padding: 15 0 5 10;"/>

    <ToggleButton fx:id="btnDashboard" text="Dashboard" onAction="#handleDashboard" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2v-view-dashboard" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnFuncionarios" text="Employees" onAction="#handleFuncionarios" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2a-account-group" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnOrders" text="Orders" onAction="#handleOrders" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2c-cart" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnProduction" text="Production" onAction="#handleProduction" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2f-factory" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnStock" text="Stock" onAction="#handleStock" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2p-package-variant" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnClients" text="Clients" onAction="#handleClients" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2b-briefcase" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <Label fx:id="lblProcurementSection" text="sidebar.procurement" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: -color-fg-muted; -fx-padding: 15 0 5 10;"/>

    <ToggleButton fx:id="btnSuppliers" text="Suppliers" onAction="#handleSuppliers" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2t-truck-delivery" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnPurchaseOrders" text="Purchase Orders" onAction="#handlePurchaseOrders" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2c-clipboard-list" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnRawMaterials" text="Raw Materials" onAction="#handleRawMaterials" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2p-package-variant" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <Label fx:id="lblCatalogSection" text="sidebar.catalog" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: -color-fg-muted; -fx-padding: 15 0 5 10;"/>

    <ToggleButton fx:id="btnPelletTypes" text="Pellet Types" onAction="#handlePelletTypes" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2g-grain" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnFormulas" text="Formulas" onAction="#handleFormulas" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2f-flask" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <ToggleButton fx:id="btnBatches" text="Batches" onAction="#handleBatches" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2c-cube-outline" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <Region VBox.vgrow="ALWAYS"/>

    <ToggleButton fx:id="btnSettings" text="Settings" onAction="#handleSettings" focusTraversable="false"
            maxWidth="Infinity" alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2c-cog" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </ToggleButton>

    <Separator style="-fx-padding: 5 0 5 0;"/>

    <Button fx:id="btnSair" text="Logout" onAction="#handleSair" maxWidth="Infinity" focusTraversable="false"
            alignment="CENTER_LEFT">
        <graphic><FontIcon iconLiteral="mdi2l-logout" iconSize="18"/></graphic>
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
    </Button>

</VBox>
