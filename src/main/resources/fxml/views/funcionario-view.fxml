<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import atlantafx.base.controls.ModalPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.FuncionarioController">

    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <!-- Header da View -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label text="Gestão de Funcionários" styleClass="title-2"/>
                <Label text="Administração da equipa Pellets Factory" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Novo Funcionário" onAction="#handleAbrirModal" prefHeight="40">
                <styleClass><String fx:value="accent"/><String fx:value="success"/></styleClass>
                <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="18"/></graphic>
            </Button>
        </HBox>

        <!-- Filtros -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroNome" promptText="Nome..." prefWidth="200"/>
            <TextField fx:id="txtFiltroNif" promptText="NIF..." prefWidth="150"/>
            <ComboBox fx:id="cmbFiltroCargo" prefWidth="180" promptText="Cargo"/>
            <Button text="Filtrar" onAction="#handleFiltrar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2f-filter" iconSize="16"/></graphic>
            </Button>
            <Button text="Limpar" onAction="#handleMostrarTodos" styleClass="button-flat">
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Tabela -->
        <TableView fx:id="tblFuncionarios" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colNumero" text="Nº" prefWidth="70"/>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="250"/>
                <TableColumn fx:id="colCargo" text="Cargo" prefWidth="150"/>
                <TableColumn fx:id="colNif" text="NIF" prefWidth="120"/>
                <TableColumn fx:id="colContacto" text="Telemóvel" prefWidth="150"/>
                <TableColumn fx:id="colDataAdmissao" text="Data Entrada" prefWidth="120"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

        <!-- Paginação será adicionada dinamicamente -->
    </VBox>

    <ModalPane fx:id="modalPane"/>
</StackPane>