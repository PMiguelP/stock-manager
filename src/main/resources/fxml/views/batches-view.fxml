<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.BatchesController">
    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">
        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="Batches" styleClass="title-2"/>
                <Label text="Batch execution and traceability" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
            </Button>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField promptText="Search batch ID..." prefWidth="320"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblBatches" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colBatch" text="Batch" prefWidth="180"/>
                <TableColumn fx:id="colFormula" text="Formula" prefWidth="170"/>
                <TableColumn fx:id="colStartedAt" text="Started At" prefWidth="220"/>
                <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="160"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="150"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</StackPane>

