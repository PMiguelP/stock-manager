<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.BatchesController">

    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="4">
                <Label text="Lotes de Pellet" styleClass="title-2"/>
                <Label text="Rastreabilidade e registo de lotes produzidos" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Atualizar" onAction="#handleRefresh" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
            </Button>
            <Button text="Novo Lote" onAction="#handleAbrirModal" styleClass="accent">
                <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="16"/></graphic>
            </Button>
        </HBox>

        <!-- Filters -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroCodigo" promptText="Pesquisar código do lote..." prefWidth="280"/>
            <Button text="Filtrar" onAction="#handleFiltrar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2f-filter-outline" iconSize="16"/></graphic>
            </Button>
            <Button text="Limpar" onAction="#handleMostrarTodos">
                <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tblLotes" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código Lote" prefWidth="180"/>
                <TableColumn fx:id="colTipoPellet" text="Tipo Pellet" prefWidth="160"/>
                <TableColumn fx:id="colQuantidade" text="Quantidade (kg)" prefWidth="140"/>
                <TableColumn fx:id="colDataProducao" text="Data Produção" prefWidth="160"/>
                <TableColumn fx:id="colLocalizacao" text="Localização" prefWidth="150"/>
                <TableColumn fx:id="colAcoes" text="Ações" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>