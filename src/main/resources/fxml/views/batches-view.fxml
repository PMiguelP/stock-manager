<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.BatchesController">

    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="4">
                <Label text="batches.title" styleClass="title-2"/>
                <Label text="batches.subtitle" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="batches.new" onAction="#handleAbrirModal" styleClass="accent">
                <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="16"/></graphic>
            </Button>
        </HBox>

        <!-- Filters -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroCodigo" promptText="batches.search" prefWidth="280"/>
            <Button text="common.filter" onAction="#handleFiltrar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2f-filter-outline" iconSize="16"/></graphic>
            </Button>
            <Button text="common.clear" onAction="#handleMostrarTodos">
                <graphic><FontIcon iconLiteral="mdi2c-close" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tblLotes" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCodigo" text="batches.batchCode" prefWidth="180"/>
                <TableColumn fx:id="colTipoPellet" text="pellet.type" prefWidth="160"/>
                <TableColumn fx:id="colQuantidade" text="batches.quantityKg" prefWidth="140"/>
                <TableColumn fx:id="colDataProducao" text="batches.productionDate" prefWidth="160"/>
                <TableColumn fx:id="colLocalizacao" text="batches.location" prefWidth="150"/>
                <TableColumn fx:id="colAcoes" text="common.actions" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
