<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.PurchaseOrdersController">

    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="purchaseOrders.title" styleClass="title-2"/>
                <Label text="purchaseOrders.subtitle" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="purchaseOrders.create" onAction="#handleAbrirModal" styleClass="accent"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="purchaseOrders.search" prefWidth="300"/>
            <ComboBox fx:id="cmbFiltroStatus" prefWidth="180" promptText="common.filterByStatus"/>
            <Button onAction="#handleLimpar" styleClass="flat">
                <tooltip><Tooltip text="common.clear"/></tooltip>
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblOrders" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colPoNumber" text="purchaseOrders.poNumber" prefWidth="130" minWidth="100" maxWidth="150"/>
                <TableColumn fx:id="colSupplier" text="suppliers.supplier" prefWidth="260"/>
                <TableColumn fx:id="colOrderDate" text="purchaseOrders.orderDate" prefWidth="150"/>
                <TableColumn fx:id="colGrandTotal" text="purchaseOrders.grandTotal" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="common.status" prefWidth="150" minWidth="120" maxWidth="180"/>
                <TableColumn fx:id="colActions" text="common.actions" prefWidth="80" minWidth="80" maxWidth="80" resizable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
