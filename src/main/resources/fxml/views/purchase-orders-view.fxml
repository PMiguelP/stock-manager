<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.PurchaseOrdersController">

    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="Purchase Orders" styleClass="title-2"/>
                <Label text="Manage raw material purchase orders" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Create Purchase Order" onAction="#handleAbrirModal" styleClass="accent"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="Search by PO number or supplier..." prefWidth="480"/>
            <ComboBox fx:id="cmbFiltroStatus" prefWidth="180" promptText="Filter by Status"/>
            <Button text="Filtrar" onAction="#handleFiltrar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2f-filter" iconSize="16"/></graphic>
            </Button>
            <Button text="Limpar" onAction="#handleLimpar" styleClass="button-flat">
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblOrders" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colPoNumber" text="PO NUMBER" prefWidth="130" minWidth="100" maxWidth="150"/>
                <TableColumn fx:id="colSupplier" text="SUPPLIER" prefWidth="260"/>
                <TableColumn fx:id="colOrderDate" text="ORDER DATE" prefWidth="150"/>
                <TableColumn fx:id="colGrandTotal" text="GRAND TOTAL" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="150" minWidth="120" maxWidth="180"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="80" minWidth="80" maxWidth="80" resizable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>