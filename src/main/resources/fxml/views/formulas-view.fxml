<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.FormulasController">
    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">
        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="Formulas" styleClass="title-2"/>
                <Label text="Recipe versions and quality performance" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
            </Button>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField promptText="Search formula code..." prefWidth="320"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblFormulas" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCode" text="Code" prefWidth="130"/>
                <TableColumn fx:id="colPelletType" text="Pellet Type" prefWidth="260"/>
                <TableColumn fx:id="colVersion" text="Version" prefWidth="150"/>
                <TableColumn fx:id="colYield" text="Yield" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="170"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</StackPane>

