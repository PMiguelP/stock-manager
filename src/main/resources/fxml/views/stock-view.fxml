<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.StockController">

    <VBox fx:id="vboxContainer" spacing="18" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="4">
                <Label text="stock.title" styleClass="title-2"/>
                <Label text="stock.subtitle" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="stock.removePellets" onAction="#handleRemoverPellets" styleClass="button-outlined"/>
            <Button text="stock.addPellets" onAction="#handleAdicionarPellets" styleClass="accent"/>
        </HBox>

        <GridPane hgap="14" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox spacing="12" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS"
                  style="-fx-padding: 18; -fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-border-color: -color-border-default; -fx-border-radius: 8;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane fx:id="iconCurrentStock"/>
                    <Label text="stock.pellets" styleClass="text-muted"/>
                </HBox>
                <Label fx:id="lblCurrentStock" text="-" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="12" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"
                  style="-fx-padding: 18; -fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-border-color: -color-border-default; -fx-border-radius: 8;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane fx:id="iconMinThreshold"/>
                    <Label text="stock.minimumDefined" styleClass="text-muted"/>
                </HBox>
                <Label fx:id="lblMinThreshold" text="-" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="12" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS"
                  style="-fx-padding: 18; -fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-border-color: -color-border-default; -fx-border-radius: 8;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane fx:id="iconAvailableStock"/>
                    <Label text="stock.rawMaterials" styleClass="text-muted"/>
                </HBox>
                <Label fx:id="lblAvailableStock" text="-" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="12" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS"
                  style="-fx-padding: 18; -fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-border-color: -color-border-default; -fx-border-radius: 8;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane fx:id="iconReservedStock"/>
                    <Label text="stock.alerts" styleClass="text-muted"/>
                </HBox>
                <Label fx:id="lblReservedStock" text="-" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            </VBox>
        </GridPane>

        <!-- Search bar -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="stock.searchPellets" prefWidth="300"/>
            <Button onAction="#handleLimpar" styleClass="flat">
                <tooltip><Tooltip text="common.clear"/></tooltip>
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Pellets stock table -->
        <TableView fx:id="tblPellets" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colNome"       text="common.name"          prefWidth="220"/>
                <TableColumn fx:id="colDiametro"   text="stock.diameterMm"     prefWidth="110"/>
                <TableColumn fx:id="colStockAtual" text="stock.current"        prefWidth="140"/>
                <TableColumn fx:id="colStockMin"   text="stock.minimum"        prefWidth="140"/>
                <TableColumn fx:id="colStatus"     text="common.status"        prefWidth="120"/>
                <TableColumn fx:id="colAcoes"      text="common.actions"       prefWidth="100"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
