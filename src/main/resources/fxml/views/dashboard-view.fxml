<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.DashboardController"
      style="-fx-background-color: -color-bg-default;">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-width: 0;">

        <VBox spacing="24" style="-fx-padding: 30;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="4">
                    <Label text="Dashboard" styleClass="title-2"/>
                    <Label text="Visão geral do sistema" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Stat Cards -->
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="14" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconTotalFuncionarios"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Total Employees" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalFuncionarios" text="—" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblSubtotalFuncionarios" text="" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="14" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconEncomendasPendentes"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Pending Orders" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblFuncionariosAtivos" text="—" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblSubtotalAtivos" text="" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="14" GridPane.columnIndex="2"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconProducaoMensal"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Monthly Production" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblProducaoMes" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblSubtotalProducao" text="" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="14" GridPane.columnIndex="3"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconStockAtual"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Current Stock" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblStockAtual" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblAlertaStock" text="" style="-fx-font-size: 11px;"/>
                </VBox>
            </GridPane>

            <!-- Quick Actions -->
            <VBox spacing="14"
                  style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                <Label text="Quick Actions" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <HBox spacing="12">
                    <Button text="Create New Order" onAction="#handleCriarEncomenda" styleClass="accent" prefHeight="40"/>
                    <Button text="Add Employee" onAction="#handleAdicionarFuncionario" prefHeight="40"/>
                    <Button text="Register Production Batch" onAction="#handleRegistarLote" prefHeight="40"/>
                </HBox>
            </VBox>

            <!-- Charts Row 1 -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Daily Production — AreaChart with NumberAxis -->
                <VBox spacing="10" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="Daily Production" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <AreaChart fx:id="chartDailyProduction" prefHeight="250"
                               legendVisible="false" animated="false"
                               style="-fx-background-color: transparent;">
                        <xAxis>
                            <NumberAxis lowerBound="1" upperBound="7" tickUnit="1" label="Day"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Production (kg)"/>
                        </yAxis>
                    </AreaChart>
                </VBox>

                <!-- Monthly Production — AreaChart with CategoryAxis, 2 series -->
                <VBox spacing="10" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="Monthly Production" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <AreaChart fx:id="chartMonthlyProduction" prefHeight="250"
                               legendVisible="true" animated="false"
                               style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis label="Month"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Production (kg)"/>
                        </yAxis>
                    </AreaChart>
                </VBox>
            </GridPane>

            <!-- Charts Row 2 -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Orders per Month — BarChart -->
                <VBox spacing="10" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="Orders per Month" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <BarChart fx:id="chartOrdersPerMonth" prefHeight="250"
                              legendVisible="false" animated="false"
                              style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis label="Month"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Orders"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <!-- Matérias Primas — PieChart -->
                <VBox spacing="10" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="Matérias Primas (Stock)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <PieChart fx:id="chartMateriasPrimas" prefHeight="250"
                              animated="false" legendVisible="true" legendSide="BOTTOM"
                              style="-fx-background-color: transparent;"/>
                </VBox>
            </GridPane>

            <!-- Charts Row 3 -->
            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Stock de Pellets — LineChart -->
                <VBox spacing="10" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="Stock de Pellets" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <LineChart fx:id="chartStockPellets" prefHeight="250"
                               legendVisible="true" animated="false"
                               style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis label="Month"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Stock (ton)"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <!-- Budget Monitoring — BubbleChart -->
                <VBox spacing="10" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="Budget Monitoring" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <BubbleChart fx:id="chartBudget" prefHeight="250"
                                 legendVisible="true" animated="false"
                                 style="-fx-background-color: transparent;">
                        <xAxis>
                            <NumberAxis lowerBound="1" upperBound="53" tickUnit="4" label="Week"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis lowerBound="0" upperBound="100" tickUnit="10" label="Budget (k€)"/>
                        </yAxis>
                    </BubbleChart>
                </VBox>

            </GridPane>

        </VBox>
    </ScrollPane>
</VBox>
