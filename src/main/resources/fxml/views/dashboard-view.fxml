<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.DashboardController"
      style="-fx-background-color: -color-bg-default;">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-width: 0;">

        <VBox spacing="24" style="-fx-padding: 30;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="4">
                    <Label text="dashboard.title" styleClass="title-2"/>
                    <Label text="dashboard.subtitle" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Stat Cards -->
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="14" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconTotalFuncionarios"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="dashboard.totalEmployees" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalFuncionarios" text="—" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblSubtotalFuncionarios" text="" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="14" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconEncomendasPendentes"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="dashboard.pendingOrders" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblFuncionariosAtivos" text="—" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblSubtotalAtivos" text="" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="14" GridPane.columnIndex="2"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconProducaoMensal"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="dashboard.monthlyProduction" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblProducaoMes" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblSubtotalProducao" text="" style="-fx-text-fill: #22c55e; -fx-font-size: 11px;"/>
                </VBox>

                <VBox spacing="14" GridPane.columnIndex="3"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 22; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="iconStockAtual"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="stock.current" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 12px;"/>
                            <Label fx:id="lblStockAtual" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblAlertaStock" text="" style="-fx-font-size: 11px;"/>
                </VBox>
            </GridPane>

            <!-- Quick Actions -->
            <VBox spacing="14"
                  style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                <Label text="dashboard.quickActions" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <HBox spacing="12">
                    <Button text="dashboard.createOrder" onAction="#handleCriarEncomenda" styleClass="accent" prefHeight="40"/>
                    <Button text="dashboard.addEmployee" onAction="#handleAdicionarFuncionario" prefHeight="40"/>
                    <Button text="dashboard.registerBatch" onAction="#handleRegistarLote" prefHeight="40"/>
                </HBox>
            </VBox>

            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="10" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="dashboard.dailyProduction" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <AreaChart fx:id="chartDailyProduction" prefHeight="250" legendVisible="false" animated="false">
                        <xAxis><CategoryAxis label="dashboard.day"/></xAxis>
                        <yAxis><NumberAxis label="dashboard.productionKg"/></yAxis>
                    </AreaChart>
                </VBox>

                <VBox spacing="10" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="dashboard.monthlyProduction" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <AreaChart fx:id="chartMonthlyProduction" prefHeight="250" legendVisible="true" animated="false">
                        <xAxis><CategoryAxis label="dashboard.month"/></xAxis>
                        <yAxis><NumberAxis label="dashboard.productionKg"/></yAxis>
                    </AreaChart>
                </VBox>
            </GridPane>

            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="10" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="dashboard.ordersPerMonth" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <BarChart fx:id="chartOrdersPerMonth" prefHeight="250" legendVisible="false" animated="false">
                        <xAxis><CategoryAxis label="dashboard.month"/></xAxis>
                        <yAxis><NumberAxis label="dashboard.orders"/></yAxis>
                    </BarChart>
                </VBox>

                <VBox spacing="10" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="dashboard.rawMaterialsStockKg" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <PieChart fx:id="chartMateriasPrimas" prefHeight="250" animated="false" legendVisible="true" legendSide="BOTTOM"/>
                </VBox>
            </GridPane>

            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="10" GridPane.columnIndex="0"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="dashboard.pelletProduction" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <LineChart fx:id="chartPelletProduction" prefHeight="250" legendVisible="true" animated="false">
                        <xAxis><CategoryAxis label="dashboard.month"/></xAxis>
                        <yAxis><NumberAxis label="dashboard.productionKg"/></yAxis>
                    </LineChart>
                </VBox>

                <VBox spacing="10" GridPane.columnIndex="1"
                      style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="dashboard.financialMovements" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <BubbleChart fx:id="chartFinancialMovements" prefHeight="250" legendVisible="true" animated="false">
                        <xAxis><NumberAxis lowerBound="1" upperBound="12" tickUnit="1" label="dashboard.week"/></xAxis>
                        <yAxis><NumberAxis label="dashboard.movements"/></yAxis>
                    </BubbleChart>
                </VBox>
            </GridPane>

        </VBox>
    </ScrollPane>
</VBox>
