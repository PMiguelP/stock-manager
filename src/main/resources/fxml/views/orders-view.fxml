<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.OrdersController">
    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="Encomendas de Clientes" styleClass="title-2"/>
                <Label text="Gestão de pedidos e entregas" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nova Encomenda" onAction="#handleAbrirModal" styleClass="accent"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroCliente" promptText="Procurar por cliente..." prefWidth="250"/>
            <ComboBox fx:id="cmbFiltroEstado" prefWidth="200" promptText="Filtrar por Estado"/>
            <Button text="Filtrar" onAction="#handleFiltrar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2f-filter" iconSize="16"/></graphic>
            </Button>
            <Button text="Limpar" onAction="#handleMostrarTodos" styleClass="button-flat">
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblEncomendas" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                <TableColumn fx:id="colData" text="Data" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="150"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                <TableColumn fx:id="colMoeda" text="Moeda" prefWidth="80"/>
                <TableColumn fx:id="colTracking" text="Tracking" prefWidth="150"/>
                <TableColumn fx:id="colAcoes" text="Ações" prefWidth="80" minWidth="80" maxWidth="80" resizable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>