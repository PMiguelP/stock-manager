<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.OrdersController">
    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="orders.title" styleClass="title-2"/>
                <Label text="orders.subtitle" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="orders.new" onAction="#handleAbrirModal" styleClass="accent"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroCliente" promptText="orders.searchCustomer" prefWidth="250"/>
            <ComboBox fx:id="cmbFiltroEstado" prefWidth="200" promptText="common.filterByStatus"/>
            <Button onAction="#handleMostrarTodos" styleClass="flat">
                <tooltip><Tooltip text="common.clear"/></tooltip>
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblEncomendas" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCliente" text="clients.customer" prefWidth="200"/>
                <TableColumn fx:id="colData" text="common.date" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="common.status" prefWidth="150"/>
                <TableColumn fx:id="colTotal" text="common.total" prefWidth="120"/>
                <TableColumn fx:id="colMoeda" text="common.currency" prefWidth="80"/>
                <TableColumn fx:id="colTracking" text="orders.tracking" prefWidth="150"/>
                <TableColumn fx:id="colAcoes" text="common.actions" prefWidth="80" minWidth="80" maxWidth="80" resizable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
