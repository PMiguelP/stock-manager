<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.SuppliersController">

    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">

        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="suppliers.title" styleClass="title-2"/>
                <Label text="suppliers.subtitle" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="suppliers.add" onAction="#handleAbrirModal" styleClass="accent"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="suppliers.search" prefWidth="480"/>
            <Button text="common.filter" onAction="#handleFiltrar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2f-filter" iconSize="16"/></graphic>
            </Button>
            <Button text="common.clear" onAction="#handleLimpar" styleClass="flat">
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblSuppliers" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colSupplierID" text="suppliers.id" prefWidth="120" minWidth="100" maxWidth="140"/>
                <TableColumn fx:id="colName" text="common.name" prefWidth="220"/>
                <TableColumn fx:id="colTaxId" text="clients.taxId" prefWidth="130"/>
                <TableColumn fx:id="colContactPerson" text="suppliers.contactPerson" prefWidth="160"/>
                <TableColumn fx:id="colActions" text="common.actions" prefWidth="80" minWidth="80" maxWidth="80" resizable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
