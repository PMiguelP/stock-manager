<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.PelletTypesController">
    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">
        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="Pellet Types" styleClass="title-2"/>
                <Label text="Commercial catalog and technical specs" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
            </Button>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroNome" promptText="Search pellet type..." prefWidth="320" onAction="#handleFiltrar"/>
            <Button text="Filter" styleClass="button-outlined" onAction="#handleFiltrar"/>
            <Button text="Clear" styleClass="button-outlined" onAction="#handleMostrarTodos"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblPelletTypes" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCodigo" text="Product ID" prefWidth="140"/>
                <TableColumn fx:id="colNome" text="Name" prefWidth="240"/>
                <TableColumn fx:id="colDiametro" text="Diameter" prefWidth="120"/>
                <TableColumn fx:id="colCalorifico" text="Calorific Value" prefWidth="160"/>
                <TableColumn fx:id="colStockAtual" text="Current Stock" prefWidth="140"/>
                <TableColumn fx:id="colStockMinimo" text="Min Stock" prefWidth="140"/>
                <TableColumn fx:id="colCustoKg" text="Cost/kg" prefWidth="110"/>
                <TableColumn fx:id="colFormula" text="Formula" prefWidth="120"/>
                <TableColumn fx:id="colAcoes" text="Actions" prefWidth="90"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</StackPane>

