<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.PelletTypesController">
    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">
        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="Pellet Types" styleClass="title-2"/>
                <Label text="Commercial catalog and technical specs" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/></graphic>
            </Button>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField promptText="Search pellet type..." prefWidth="320"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblPelletTypes" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCode" text="Code" prefWidth="130"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="260"/>
                <TableColumn fx:id="colDiameter" text="Diameter" prefWidth="150"/>
                <TableColumn fx:id="colMoisture" text="Moisture" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="150"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</StackPane>

