<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pelletsfactory.stock_manager.desktop.controllers.PelletTypesController">
    <VBox fx:id="vboxContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: -color-bg-default;">
        <HBox alignment="CENTER_LEFT">
            <VBox>
                <Label text="pelletTypes.title" styleClass="title-2"/>
                <Label text="pelletTypes.subtitle" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="pelletTypes.new" onAction="#handleAbrirModal" styleClass="accent"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="pelletTypes.search" prefWidth="320"/>
            <Button onAction="#handleLimpar" styleClass="flat">
                <tooltip><Tooltip text="common.clear"/></tooltip>
                <graphic><FontIcon iconLiteral="mdi2c-close-circle-outline" iconSize="16"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="tblPelletTypes" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCodigo" text="pelletTypes.productId" prefWidth="140"/>
                <TableColumn fx:id="colNome" text="common.name" prefWidth="240"/>
                <TableColumn fx:id="colDiametro" text="pelletTypes.diameter" prefWidth="120"/>
                <TableColumn fx:id="colCalorifico" text="pelletTypes.calorificValue" prefWidth="160"/>
                <TableColumn fx:id="colStockAtual" text="stock.current" prefWidth="140"/>
                <TableColumn fx:id="colStockMinimo" text="stock.minimumShort" prefWidth="140"/>
                <TableColumn fx:id="colCustoKg" text="pelletTypes.costKg" prefWidth="110"/>
                <TableColumn fx:id="colFormula" text="pelletTypes.formula" prefWidth="120"/>
                <TableColumn fx:id="colAcoes" text="common.actions" prefWidth="90"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</StackPane>
